      Polish: 
      Ukrainian: 
  - localizationKey: GAMEPLAY_Shotgun_SkillTier2Benefits
    languages:
      English: 'Faster reloading, aiming and equipping

        Recoil kick reduced
        by 25%

        Low critical hit chance'
      German: 
      Russian: 
      French: 
      Japanese: 
      Korean: 
      SimplifiedChinese: 
      Swedish: 
