      Polish: 
      Ukrainian: 
  - localizationKey: GAMEPLAY_Shotgun_SkillTier4Benefits
    languages:
      English: 'Faster reloading, aiming and equipping

        Recoil kick reduced
        by 75%

        Unload both barrels quickly

        Keep the unspent shell
        when switching ammo

        Close the breech while raising the gun to aim

        High
        critical hit chance'
      German: 
      Russian: 
      French: 
      Japanese: 
      Korean: 
      SimplifiedChinese: 
      Swedish: 
      TraditionalChinese: 
