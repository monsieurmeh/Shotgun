      Finnish: 
      Italian: 
      Polish: 
      Ukrainian: 
  - localizationKey: GAMEPLAY_DoubleBarrel_SkillTier2Benefits
    languages:
      English: 'Faster reloading, aiming and equipping

        Recoil kick reduced
        by 25%

        Low critical hit chance'
