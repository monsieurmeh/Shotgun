      Ukrainian: 
  - localizationKey: GAMEPLAY_Shotgun_SkillTier3Benefits
    languages:
      English: 'Faster reloading, aiming and equipping

        Recoil kick reduced
        by 50%

        Steadier recovery after each shot

        Unload and load
        both barrels at medium speed

        Moderate critical hit chance'
      German: 
      Russian: 
      French: 
      Japanese: 
      Korean: 
      SimplifiedChinese: 
      Swedish: 
      TraditionalChinese: 
      Turkish: 
      Norwegian: 
